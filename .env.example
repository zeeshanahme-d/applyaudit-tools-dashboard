# The existing Next.js app that serves the analysis API (no trailing slash).
# Production: the marketing app's origin, e.g. https://applyaudit.com.
# That app must have NEXT_PUBLIC_TOOLS_APP_URL set to THIS app's origin, or its
# API refuses the browser's cross-origin calls (CORS, marketing/next.config.ts).
VITE_API_URL=http://localhost:3000

# Brand name shown in the app; the same as the marketing app's NEXT_PUBLIC_APP_NAME.
VITE_APP_NAME=ApplyAudit

# Resume upload limits the browser checks before sending (whole numbers above zero).
# Keep equal to the API's ANALYSIS_MAX_FILE_MB / ANALYSIS_MAX_PAGES (marketing/.env),
# or the page promises what the server refuses. Unset: the API's defaults, 2 MB and 3 pages.
VITE_MAX_FILE_MB=2
VITE_MAX_PAGES=3
